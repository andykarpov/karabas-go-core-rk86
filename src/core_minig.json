        {"type": "P", "name": ""},
        {"type": "S", "name": "Text color", "options": ["White","Green"], "default": 0, "hotkey": "Menu+V"},
        {"type": "S", "name": "Sound", "options": ["off","on"], "default": 1, "hotkey": "Menu+M"},
        {"type": "S", "name": "ROM", "options": ["BIOSSD","BIOS"], "default": 0, "hotkey": "Menu+B"},
        {"type": "P", "name": ""},
        {"type": "P", "name": "Enable autorun to autostart"},
        {"type": "P", "name": "a tape image after loading"},
        {"type": "S", "name": "Autorun", "options": ["off","on"], "default": 1, "hotkey": "Menu+A"},
        {"type": "P", "name": ""},
        {"type": "T", "name": "Reset", "options": null, "default": 0, "hotkey": "Ctrl+Alt+Del"}
    ]
